{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "tagTemplate": "{name}-v{version}",
    "recoverMissedReleases": true,
    "updateLockfiles": true,
    "commitFormats": {
      "patch": ["fix:*", "fix(?*):*", "perf:*", "perf(?*):*", "refactor:*", "refactor(?*):*", "chore(catalog):*"]
    }
  },
  "package": [
    {
      "name": "api",
      "path": "api",
      "changelog": "api/CHANGELOG.md",
      "versionedFiles": [{ "path": "api/Cargo.toml", "format": "toml" }]
    },
    {
      "name": "site",
      "path": "site",
      "changelog": "site/CHANGELOG.md",
      "sharedPaths": [
        "generated/catalog.json",
        "generated/events.json",
        "CONTRIBUTING.md",
        "data/categories.yaml",
        "data/category-redirects.yaml",
        "data/migrations",
        "data/benchmarks",
        "scripts/lib/types.ts",
        "scripts/lib/rules.ts",
        "scripts/lib/trending.ts",
        "scripts/lib/contributors.ts",
        "scripts/lib/order.ts"
      ],
      "versionedFiles": [{ "path": "site/package.json", "format": "json" }]
    },
    {
      "name": "refresh",
      "path": "scripts/runner",
      "changelog": "scripts/runner/CHANGELOG.md",
      "sharedPaths": ["scripts", "schema/maintainer-file.schema.json", "package.json", "pnpm-lock.yaml"]
    }
  ]
}
