---
import type { Locale } from "../i18n/index.ts";
import { messages } from "../i18n/index.ts";
import type { GridItem } from "../lib/types.ts";

interface Props {
  locale: Locale;
  items: GridItem[];
}

const { locale, items } = Astro.props;
const m = messages(locale);
---

<ul class="targets">
  {
    items.map((item) => (
      <li>
        <a href={item.href}>
          <span>
            <span class="target-name">
              {item.name}
              {item.archived && <span class="mark mark-archived">{m.target.archived}</span>}
            </span>
            {item.detail && <span class="target-category">{item.detail}</span>}
          </span>
          <span class="target-count">{item.count} →</span>
        </a>
      </li>
    ))
  }
</ul>
