---
import type { Locale } from "../i18n/index.ts";
import { messages, pathFor, plural } from "../i18n/index.ts";
import Base from "../layouts/Base.astro";
import { itemList } from "../lib/structuredData.ts";
import type { ToolView } from "../lib/types.ts";
import { ToolCard } from "./ToolCard.tsx";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  context: string;
  parent: string;
  heading: string;
  lede: string;
  tools: ToolView[];
}

const { locale, title, description, context, parent, heading, lede, tools } = Astro.props;
const m = messages(locale);
const listed = itemList(
  heading,
  tools.map((tool) => ({ name: tool.name, url: new URL(pathFor(locale, `/tools/${tool.slug}/`), Astro.site).href })),
);
---

<Base title={title} description={description} structuredData={[listed]}>
  <a class="back" href={parent}>{m.listing.back}</a>
  <p class="context"><a href={parent}>{context}</a></p>
  <h1>{heading}</h1>
  <p class="lede">{lede}</p>
  <slot />
  <p class="summary">{plural(locale, m.listing.toolCount, tools.length)}</p>
  <div class="tools listing">
    {tools.map((tool) => <ToolCard locale={locale} strings={m.islands} tool={tool} />)}
  </div>
  <slot name="after" />
</Base>
