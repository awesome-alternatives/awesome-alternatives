---
import type { Locale } from "../i18n/index.ts";
import { messages, pathFor, plural } from "../i18n/index.ts";
import Base from "../layouts/Base.astro";
import type { Crumb } from "../lib/breadcrumbs.ts";
import { breadcrumbList, itemList } from "../lib/structuredData.ts";
import type { FeedLink, ToolView } from "../lib/types.ts";
import { ToolCard } from "./ToolCard.tsx";
import ToolTable from "./ToolTable.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  context: string;
  parent: string;
  heading: string;
  lede: string;
  tools: ToolView[];
  feeds?: FeedLink[];
  compact?: boolean;
  crumbs?: Crumb[];
}

const { locale, title, description, context, parent, heading, lede, tools, feeds = [], compact = false, crumbs } =
  Astro.props;
const m = messages(locale);
const listed = itemList(
  heading,
  tools.map((tool) => ({ name: tool.name, url: new URL(pathFor(locale, `/tools/${tool.slug}/`), Astro.site).href })),
);
const trail = crumbs && breadcrumbList(crumbs.map((crumb) => ({ name: crumb.name, url: new URL(crumb.href, Astro.site).href })));
---

<Base title={title} description={description} structuredData={trail ? [listed, trail] : [listed]} feeds={feeds}>
  <a class="back" href={parent}>{m.listing.back}</a>
  <p class="context"><a href={parent}>{context}</a></p>
  <h1>{heading}</h1>
  <p class="lede">{lede}</p>
  <slot />
  <p class="summary">{plural(locale, m.listing.toolCount, tools.length)}</p>
  {
    compact ? (
      <ToolTable locale={locale} caption={heading} tools={tools} />
    ) : (
      <div class="tools listing">
        {tools.map((tool) => <ToolCard locale={locale} strings={m.islands} tool={tool} />)}
      </div>
    )
  }
  <slot name="after" />
</Base>
