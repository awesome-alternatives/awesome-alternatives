---
import type { Locale } from "../i18n/index.ts";
import { messages, pathFor } from "../i18n/index.ts";
import Base from "../layouts/Base.astro";
import type { GridItem } from "../lib/types.ts";
import LinkGrid from "./LinkGrid.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  heading: string;
  lede: string;
  items: GridItem[];
}

const { locale, title, description, heading, lede, items } = Astro.props;
const m = messages(locale);
---

<Base title={title} description={description}>
  <a class="back" href={`${pathFor(locale, "/")}#browse`}>{m.listing.back}</a>
  <p class="context">{m.listing.browse}</p>
  <h1>{heading}</h1>
  <p class="lede">{lede}</p>
  <div class="listing">
    <LinkGrid locale={locale} items={items} />
  </div>
</Base>
