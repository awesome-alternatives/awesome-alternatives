---
import type { BannedTool } from "../../../scripts/lib/types.ts";
import type { Locale } from "../i18n/index.ts";
import { format, messages, pathFor } from "../i18n/index.ts";
import Base from "../layouts/Base.astro";

interface Props {
  locale: Locale;
  entry: BannedTool;
}

const { locale, entry } = Astro.props;
const { banned } = messages(locale);
const title = format(banned.title, { name: entry.name });
---

<Base title={title} description={format(banned.description, { name: entry.name })} noindex nofollow>
  <h1>{format(banned.heading, { name: entry.name })}</h1>
  <p class="lede">{banned.notice}</p>
  <p><strong>{banned.reason}:</strong> {entry.reason}</p>
  <p><a href={pathFor(locale, "/tools/")}>{banned.back}</a></p>
</Base>
