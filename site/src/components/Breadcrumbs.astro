---
import type { Locale } from "../i18n/index.ts";
import { messages } from "../i18n/index.ts";
import type { Crumb } from "../lib/breadcrumbs.ts";

interface Props {
  locale: Locale;
  crumbs: Crumb[];
}

const { locale, crumbs } = Astro.props;
const m = messages(locale);
const last = crumbs.length - 1;
---

<nav class="breadcrumbs" aria-label={m.breadcrumb.label}>
  <ol>
    {
      crumbs.map((crumb, index) => (
        <li>{index === last ? <span aria-current="page">{crumb.name}</span> : <a href={crumb.href}>{crumb.name}</a>}</li>
      ))
    }
  </ol>
</nav>
