---
import type { EnrichedTool } from "../../../../scripts/lib/types.ts";
import type { GetStaticPaths } from "astro";

import ToolListing from "../../components/ToolListing.astro";
import { languageGroups } from "../../lib/catalog.ts";

export const getStaticPaths = (() =>
  languageGroups.map((group) => ({
    params: { language: group.slug },
    props: { language: group.label, tools: group.tools },
  }))) satisfies GetStaticPaths;

interface Props {
  language: string;
  tools: EnrichedTool[];
}

const { language, tools } = Astro.props;
---

<ToolListing
  title={`Developer tools written in ${language}`}
  description={`${tools.length} tools in the catalog written in ${language}, with licence, stars and latest release.`}
  context="language"
  parent="/languages/"
  heading={language}
  lede={`Tools whose repository GitHub reports as mostly ${language}.`}
  tools={tools}
/>
