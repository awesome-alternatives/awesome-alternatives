---
import IndexPage from "../../components/IndexPage.astro";
import { languageGroups } from "../../lib/catalog.ts";

const items = languageGroups.map((group) => ({
  href: `/languages/${group.slug}/`,
  name: group.label,
  count: group.tools.length,
}));
---

<IndexPage
  title="Developer tools by language"
  description={`Browse the catalog by the language each tool is written in, across ${items.length} languages.`}
  heading="Languages"
  lede="The language GitHub reports for each repository."
  items={items}
/>
