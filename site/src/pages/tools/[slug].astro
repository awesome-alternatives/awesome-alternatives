---
import type { EnrichedTool } from "../../../../scripts/lib/types.ts";
import type { GetStaticPaths } from "astro";

import ToolTabs from "../../components/ToolTabs.tsx";
import Base from "../../layouts/Base.astro";
import { alternativesTo } from "../../lib/filter.ts";
import { categories, toolBySlug, tools } from "../../lib/catalog.ts";
import { day, stars } from "../../lib/format.ts";
import { slugify } from "../../lib/slug.ts";

export const getStaticPaths = (() =>
  tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }))) satisfies GetStaticPaths;

interface Props {
  tool: EnrichedTool;
}

const { tool } = Astro.props;
const { repo, release, releases } = tool;
const replacedBy = alternativesTo(tools, tool.slug);
const category = categories[tool.category];
const nameOf = (slug: string) => toolBySlug(slug)?.name ?? slug;
const back = tool.replaces[0] ? `/alternatives/${tool.replaces[0].tool}/` : "/";
const topics = repo.topics.filter((t) => t !== "hacktoberfest").slice(0, 8);
const edit = `https://github.com/awesome-alternatives/awesome-alternatives/edit/main/data/tools/${tool.slug}.yaml`;
const source = tool.path ? `${tool.repository}/tree/HEAD/${tool.path}` : tool.repository;
const replaces = tool.replaces.map((r) => ({ slug: r.tool, name: nameOf(r.tool), fit: r.fit, note: r.note ?? null }));
---

<Base
  title={`${tool.name}: ${repo.language ?? "tool"} for ${category?.name.toLowerCase() ?? tool.category}`}
  description={repo.description ?? `${tool.name} in the awesome-alternatives catalog.`}
>
  <div class="wide">
    <a class="back" href={back}>← back</a>
    {
      tool.replaces.length > 0 && (
        <p class="context">
          alternative to{" "}
          {tool.replaces.map((r, i) => (
            <>
              {i > 0 && ", "}
              <a href={`/alternatives/${r.tool}/`}>{nameOf(r.tool)}</a>
            </>
          ))}
        </p>
      )
    }
    <h1>
      {tool.name}
      {repo.archived && <a class="mark mark-archived" href="/about/#archived">archived</a>}
    </h1>

    <div class="tool-layout">
      <ToolTabs
        client:load
        slug={tool.slug}
        repository={tool.repository}
        releases={releases}
        latest={release ? { tag: release.tag, signed: release.signed } : null}
        replaces={replaces}
        alternatives={replacedBy}
      />

      <aside class="about">
        <p class="section-label">About</p>
        {repo.description && <p class="about-description">{repo.description}</p>}
        {
          repo.archived && (
            <p class="archived-note">
              This repository is archived and no longer receives changes. It is listed so you can find what replaces it.
            </p>
          )
        }
        {tool.affiliation && <p class="affiliation">{tool.affiliation}</p>}

        <div class="badges">
          {repo.language && <span class="tag">{repo.language}</span>}
          <a class="tag" href={`/categories/${slugify(tool.category)}/`}>{category?.name ?? tool.category}</a>
          {repo.license && <span class="tag">{repo.license}</span>}
          {release?.signed && <a class="tag" href="/about/#signed">✓ signed</a>}
          {tool.maintainerVerified && <a class="tag" href="/about/#verified">✓ verified</a>}
        </div>

        <dl class="about-facts">
          <div>
            <dt>Stars</dt>
            <dd>{stars(repo.stars)}</dd>
          </div>
          <div>
            <dt>Forks</dt>
            <dd>{stars(repo.forks)}</dd>
          </div>
          <div>
            <dt>Latest</dt>
            <dd>{release ? <a href={release.url}>{release.tag}</a> : "none"}</dd>
          </div>
          <div>
            <dt>Last push</dt>
            <dd>{day(repo.pushedAt)}</dd>
          </div>
        </dl>

        {
          topics.length > 0 && (
            <div class="tags">
              {topics.map((topic) => (
                <span class="tag">#{topic}</span>
              ))}
            </div>
          )
        }

        <p class="about-links">
          <a class="repo-link" href={source}>github.com/{repo.fullName}{tool.path && `/${tool.path}`} ↗</a>
          {repo.homepage && <a href={repo.homepage}>Website ↗</a>}
          <a href={edit}>Edit this entry</a>
        </p>
      </aside>
    </div>
  </div>
</Base>
