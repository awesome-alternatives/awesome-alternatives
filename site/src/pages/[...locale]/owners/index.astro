---
import type { GetStaticPaths } from "astro";

import IndexPage from "../../../components/IndexPage.astro";
import type { Locale } from "../../../i18n/index.ts";
import { format, messages, pathFor } from "../../../i18n/index.ts";
import { localePaths } from "../../../i18n/paths.ts";
import { ownerFacts, ownerGroups } from "../../../lib/catalog.ts";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = messages(locale).index.owners;
const items = ownerGroups.map((group) => {
  const facts = ownerFacts(group.label);
  const name = facts?.name ?? group.label;
  return {
    href: pathFor(locale, `/owners/${group.slug}/`),
    name,
    detail: name === group.label ? undefined : group.label,
    count: group.tools.length,
  };
});
const count = items.length;
---

<IndexPage
  locale={locale}
  title={m.title}
  description={format(m.description, { count })}
  heading={m.heading}
  lede={format(m.lede, { count })}
  items={items}
/>
