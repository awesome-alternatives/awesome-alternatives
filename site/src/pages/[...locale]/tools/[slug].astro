---
import type { EnrichedTool } from "../../../../../scripts/lib/types.ts";
import type { GetStaticPaths } from "astro";

import { Mark } from "../../../components/Mark.tsx";
import ReplacedBy from "../../../components/ReplacedBy.astro";
import StarChart from "../../../components/StarChart.astro";
import ToolTabs from "../../../components/ToolTabs.tsx";
import type { Locale } from "../../../i18n/index.ts";
import { format, messages, pathFor } from "../../../i18n/index.ts";
import { localePathsFor } from "../../../i18n/paths.ts";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Base from "../../../layouts/Base.astro";
import { withHome } from "../../../lib/breadcrumbs.ts";
import { canonicalForTool } from "../../../lib/canonical.ts";
import { categories, checkedAt, nameOf, ownerHref, ownerName, pairs, tools } from "../../../lib/catalog.ts";
import { comparePath, pairForTool } from "../../../lib/compare.ts";
import { loginOf } from "../../../lib/owners.ts";
import { alternativesTo } from "../../../lib/filter.ts";
import { day, stars } from "../../../lib/format.ts";
import { historyUrl } from "../../../lib/freshness.ts";
import { webHref } from "../../../lib/href.ts";
import { toolDescription } from "../../../lib/intent.ts";
import { migrationPairs } from "../../../lib/migrationPages.ts";
import { migrationPath } from "../../../lib/migrations.ts";
import { breadcrumbList, softwareSourceCode } from "../../../lib/structuredData.ts";
import { slugify } from "../../../lib/slug.ts";

export const getStaticPaths = (() =>
  localePathsFor(tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } })))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  tool: EnrichedTool;
}

const { locale, tool } = Astro.props;
const m = messages(locale);
const { repo, release, releases } = tool;
const homepage = webHref(repo.homepage);
const replacedBy = alternativesTo(tools, tool.slug);
const category = categories[tool.category];
const absolute = (path: string) => new URL(path, Astro.site).href;
const crumbs = withHome(locale, m.breadcrumb.home, [
  { name: category?.name ?? tool.category, href: pathFor(locale, `/categories/${slugify(tool.category)}/`) },
  { name: tool.name, href: pathFor(locale, `/tools/${tool.slug}/`) },
]);
const related = tools
  .filter((other) => other.category === tool.category && other.slug !== tool.slug && !other.repo.archived)
  .sort((a, b) => b.repo.stars - a.repo.stars);
const topics = repo.topics.filter((t) => t !== "hacktoberfest").slice(0, 8);
const edit = `https://github.com/awesome-alternatives/awesome-alternatives/edit/main/data/tools/${tool.slug}.yaml`;
const source = tool.path ? `${tool.repository}/tree/HEAD/${tool.path}` : tool.repository;
const capabilityList = Object.entries(tool.capabilities).map(([key, capability]) => ({
  label: category?.capabilities?.[key]?.label ?? key,
  docs: capability.docs,
  note: capability.note ?? null,
}));
const withNotes = new Set(
  (await migrationPairs()).filter((pair) => pair.to === tool.slug).map((pair) => pair.from),
);
const replaces = tool.replaces.map((r) => ({
  slug: r.tool,
  name: nameOf(r.tool),
  fit: r.fit,
  note: r.note ?? null,
  migration: r.migration ?? null,
  notes: withNotes.has(r.tool) ? pathFor(locale, migrationPath(r.tool, tool.slug)) : null,
}));
const login = loginOf(repo.fullName);
const comparable = pairForTool(pairs, tool.slug);
const counterpart = comparable && (comparable.a.slug === tool.slug ? comparable.b : comparable.a);
---

<Base
  title={format(m.tool.title, {
    name: tool.name,
    language: repo.language ?? m.tool.titleFallbackLanguage,
    category: category?.name.toLowerCase() ?? tool.category,
  })}
  description={toolDescription(tool, tools, format(m.tool.descriptionFallback, { name: tool.name }))}
  canonicalPath={canonicalForTool(tool.slug, replacedBy.length)}
  structuredData={[
    softwareSourceCode(tool, absolute(pathFor(locale, `/tools/${tool.slug}/`))),
    breadcrumbList(crumbs.map((crumb) => ({ name: crumb.name, url: absolute(crumb.href) }))),
  ]}
>
  <div class="wide">
    <Breadcrumbs locale={locale} crumbs={crumbs} />
    {
      tool.replaces.length > 0 && (
        <p class="context">
          {m.tool.alternativeTo}{" "}
          {tool.replaces.map((r, i) => (
            <>
              {i > 0 && ", "}
              <a href={pathFor(locale, `/alternatives/${r.tool}/`)}>{nameOf(r.tool)}</a>
            </>
          ))}
        </p>
      )
    }
    <h1>
      {tool.name}
      <Mark
        icon="verified"
        muted={!tool.maintainerVerified}
        label={tool.maintainerVerified ? m.tool.verified : m.tool.unverified}
        href={`${pathFor(locale, "/about/")}#verified`}
      />
      {
        repo.archived && (
          <a class="mark mark-archived" href={`${pathFor(locale, "/about/")}#archived`}>
            {m.tool.archived}
          </a>
        )
      }
    </h1>

    <ReplacedBy locale={locale} target={tool.slug} name={tool.name} alternatives={replacedBy} />

    <div class="tool-layout">
      <ToolTabs
        client:load
        locale={locale}
        strings={m.islands}
        slug={tool.slug}
        repository={tool.repository}
        releases={releases}
        latest={release ? { tag: release.tag, signed: release.signed } : null}
        replaces={replaces}
        alternatives={replacedBy}
      />

      <aside class="about">
        <p class="section-label">{m.tool.aboutLabel}</p>
        {repo.description && <p class="about-description">{repo.description}</p>}
        {repo.archived && <p class="archived-note">{m.tool.archivedNote}</p>}
        {tool.affiliation && <p class="affiliation">{tool.affiliation}</p>}

        <div class="badges">
          {repo.language && <span class="tag">{repo.language}</span>}
          <a class="tag" href={pathFor(locale, `/categories/${slugify(tool.category)}/`)}>
            {category?.name ?? tool.category}
          </a>
          {repo.license && <span class="tag">{repo.license}</span>}
          {release?.signed && <Mark icon="signed" label={m.tool.signed} href={`${pathFor(locale, "/about/")}#signed`} />}
        </div>

        <dl class="about-facts">
          <div class="full">
            <dt>{m.tool.owner}</dt>
            <dd><a href={ownerHref(locale, login)}>{ownerName(login)}</a></dd>
          </div>
          <div>
            <dt>{m.tool.stars}</dt>
            <dd>{stars(repo.stars)}</dd>
          </div>
          <div>
            <dt>{m.tool.forks}</dt>
            <dd>{stars(repo.forks)}</dd>
          </div>
          <div>
            <dt>{m.tool.latest}</dt>
            <dd>{release ? <a href={release.url}>{release.tag}</a> : m.tool.noRelease}</dd>
          </div>
          <div>
            <dt>{m.tool.lastPush}</dt>
            <dd>{day(repo.pushedAt)}</dd>
          </div>
          <div class={category?.selfHost ? undefined : "full"}>
            <dt>{m.tool.terms}</dt>
            <dd>{m.islands.terms[tool.terms]}</dd>
          </div>
          {
            category?.selfHost && (
              <div>
                <dt>{m.tool.selfHost}</dt>
                <dd>{m.tool.selfHostYes}</dd>
              </div>
            )
          }
          {
            tool.deploy.length > 0 && (
              <div class="full">
                <dt>{m.tool.deploy}</dt>
                <dd>{tool.deploy.map((method) => m.islands.deploy[method]).join(", ")}</dd>
              </div>
            )
          }
          {tool.starHistory && <StarChart locale={locale} series={tool.starHistory} />}
        </dl>
        {
          capabilityList.length > 0 && (
            <div class="capabilities">
              <p class="section-label">{m.tool.capabilities}</p>
              <ul>
                {capabilityList.map((capability) => (
                  <li>
                    {capability.label} <a href={capability.docs}>{m.tool.capabilityDocs}</a>
                    {capability.note && <span class="capability-note"> {capability.note}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <p class="freshness">
          {
            checkedAt && (
              <a href={`${pathFor(locale, "/about/")}#refresh`}>{format(m.tool.checked, { date: day(checkedAt) ?? "" })}</a>
            )
          }
          <a href={historyUrl(tool.slug)}>{format(m.tool.edited, { date: day(tool.editedAt) ?? "" })}</a>
        </p>

        {
          counterpart && (
            <p class="compare-link">
              <a href={pathFor(locale, comparePath(tool.slug, counterpart.slug))}>
                {format(m.compare.entry, { a: tool.name, b: counterpart.name })}
              </a>
            </p>
          )
        }

        {
          topics.length > 0 && (
            <div class="tags">
              {topics.map((topic) => (
                <span class="tag">#{topic}</span>
              ))}
            </div>
          )
        }

        <p class="about-links">
          <a class="repo-link" href={source}>github.com/{repo.fullName}{tool.path && `/${tool.path}`} ↗</a>
          {homepage && <a href={homepage}>{m.tool.website}</a>}
          <a href={edit}>{m.tool.edit}</a>
        </p>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="page-section">
          <h2>{format(m.tool.related, { category: category?.name ?? tool.category })}</h2>
          <ul class="targets">
            {related.map((other) => (
              <li>
                <a href={pathFor(locale, `/tools/${other.slug}/`)}>
                  <span>
                    <span class="target-name">{other.name}</span>
                    <span class="target-category">{other.repo.language ?? m.islands.card.unknownLanguage}</span>
                  </span>
                  <span class="target-count">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
