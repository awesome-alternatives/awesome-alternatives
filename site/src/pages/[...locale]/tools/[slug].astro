---
import type { GetStaticPaths } from "astro";

import type { BannedTool, EnrichedTool } from "../../../../../scripts/lib/types.ts";
import BannedToolPage from "../../../components/BannedToolPage.astro";
import ToolPage from "../../../components/ToolPage.astro";
import type { Locale } from "../../../i18n/index.ts";
import { localePathsFor } from "../../../i18n/paths.ts";
import { banned, tools } from "../../../lib/catalog.ts";

interface Props {
  locale: Locale;
  tool: EnrichedTool | null;
  entry: BannedTool | null;
}

type Page = { params: { slug: string }; props: Omit<Props, "locale"> };

export const getStaticPaths = (() =>
  localePathsFor<Omit<Props, "locale">>([
    ...tools.map((tool): Page => ({ params: { slug: tool.slug }, props: { tool, entry: null } })),
    ...banned.map((entry): Page => ({ params: { slug: entry.slug }, props: { tool: null, entry } })),
  ])) satisfies GetStaticPaths;

const { locale, tool, entry } = Astro.props;
---

{entry ? <BannedToolPage locale={locale} entry={entry} /> : tool && <ToolPage locale={locale} tool={tool} />}
