---
import type { GetStaticPaths } from "astro";

import IndexPage from "../../../components/IndexPage.astro";
import type { Locale } from "../../../i18n/index.ts";
import { format, messages, pathFor } from "../../../i18n/index.ts";
import { localePaths } from "../../../i18n/paths.ts";
import { targetItems } from "../../../lib/catalog.ts";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = messages(locale).index.alternatives;
const items = targetItems().map((item) => ({ ...item, href: pathFor(locale, item.href) }));
const count = items.length;
---

<IndexPage
  locale={locale}
  title={m.title}
  description={format(m.description, { count })}
  heading={m.heading}
  lede={format(m.lede, { count })}
  items={items}
/>
