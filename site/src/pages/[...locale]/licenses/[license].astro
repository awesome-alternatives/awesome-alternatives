---
import type { EnrichedTool } from "../../../../../scripts/lib/types.ts";
import type { GetStaticPaths } from "astro";

import ToolListing from "../../../components/ToolListing.astro";
import type { Locale } from "../../../i18n/index.ts";
import { format, messages, pathFor } from "../../../i18n/index.ts";
import { localePathsFor } from "../../../i18n/paths.ts";
import { licenseGroups } from "../../../lib/catalog.ts";

export const getStaticPaths = (() =>
  localePathsFor(
    licenseGroups.map((group) => ({
      params: { license: group.slug },
      props: { license: group.label, tools: group.tools },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  license: string;
  tools: EnrichedTool[];
}

const { locale, license, tools } = Astro.props;
const m = messages(locale).license;
---

<ToolListing
  locale={locale}
  title={format(m.title, { name: license })}
  description={format(m.description, { name: license, count: tools.length })}
  context={m.context}
  parent={pathFor(locale, "/licenses/")}
  heading={license}
  lede={format(m.lede, { name: license })}
  tools={tools}
/>
