---
import type { EnrichedTool } from "../../../../../scripts/lib/types.ts";
import type { GetStaticPaths } from "astro";
import { getEntry } from "astro:content";

import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CompareRow from "../../../components/CompareRow.astro";
import CompareTabs from "../../../components/CompareTabs.tsx";
import { Mark } from "../../../components/Mark.tsx";
import { StarCount } from "../../../components/StarCount.tsx";
import type { Locale } from "../../../i18n/index.ts";
import { format, messages, pathFor, plural } from "../../../i18n/index.ts";
import { localePathsFor } from "../../../i18n/paths.ts";
import Base from "../../../layouts/Base.astro";
import { withHome } from "../../../lib/breadcrumbs.ts";
import { cadenceDays } from "../../../lib/cadence.ts";
import { categoryName, nameOf, pairs } from "../../../lib/catalog.ts";
import type { Pair } from "../../../lib/compare.ts";
import { day } from "../../../lib/format.ts";
import { webHref } from "../../../lib/href.ts";
import { migrationPairs } from "../../../lib/migrationPages.ts";
import { migrationPath } from "../../../lib/migrations.ts";
import { slugify } from "../../../lib/slug.ts";
import { breadcrumbList } from "../../../lib/structuredData.ts";
import { THIRD_PARTY } from "../../../../../scripts/lib/types.ts";

export const getStaticPaths = (() =>
  localePathsFor(
    pairs.map((pair) => ({ params: { pair: pair.slug }, props: { pair } })),
  )) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  pair: Pair<EnrichedTool>;
}

const { locale, pair } = Astro.props;
const { a, b } = pair;
const m = messages(locale);
const card = m.islands.card;
const flagLabels: Record<string, string> = m.islands.flag;
const names: [string, string] = [a.name, b.name];
const heading = format(m.compare.title, { a: a.name, b: b.name });
const crumbs = withHome(locale, m.breadcrumb.home, [
  { name: categoryName(a.category), href: pathFor(locale, `/categories/${slugify(a.category)}/`) },
  { name: heading, href: pathFor(locale, `/compare/${pair.slug}/`) },
]);
const trail = breadcrumbList(crumbs.map((crumb) => ({ name: crumb.name, url: new URL(crumb.href, Astro.site).href })));
const cadence = (tool: EnrichedTool) => {
  const days = cadenceDays(tool.releases);
  return days === null ? m.compare.cadenceUnknown : plural(locale, m.compare.cadence, days);
};
const flagsOf = (tool: EnrichedTool) => tool.flags.filter((flag) => flag !== "archived");
const languageHref = (language: string) => pathFor(locale, `/languages/${slugify(language)}/`);
const licenseHref = (license: string) => pathFor(locale, `/licenses/${slugify(license)}/`);
const flagHref = (flag: string) => pathFor(locale, `/about/#${flag in flagLabels ? flag : "warnings"}`);
const fitHref = (fit: string) => pathFor(locale, `/about/#${fit}`);
const targetHref = (target: string) => pathFor(locale, `/alternatives/${target}/`);
const targetLabel = (target: string) => format(m.compare.targetLink, { name: nameOf(target) });
const contributorsOf = (tool: EnrichedTool) => {
  const contributors = tool.contributors;
  if (!contributors) return m.compare.contributorsUnknown;
  return contributors.capped
    ? format(m.vitality.contributorsCapped, { n: contributors.count })
    : plural(locale, m.vitality.contributorsCount, contributors.count);
};
const sideOf = (tool: EnrichedTool) => ({
  name: tool.name,
  slug: tool.slug,
  repository: tool.repository,
  releases: tool.releases,
  latest: tool.release ? { tag: tool.release.tag, signed: tool.release.signed } : null,
});
const between = new Set([`${a.slug}/${b.slug}`, `${b.slug}/${a.slug}`]);
const guides = (await migrationPairs()).filter((guide) => between.has(`${guide.from}/${guide.to}`));
const measured = await getEntry("benchmarks", [a.slug, b.slug].sort().join("--"));
const ranBy = (slug: string, date: string) =>
  slug === THIRD_PARTY ? format(m.compare.ranByThirdParty, { date }) : format(m.compare.ranByProject, { name: nameOf(slug), date });
---

<Base
  title={format(m.compare.pageTitle, { a: a.name, b: b.name })}
  description={format(m.compare.description, { a: a.name, b: b.name })}
  structuredData={[trail]}
>
  <div class="wide">
    <Breadcrumbs locale={locale} crumbs={crumbs} />
    <p class="context">{m.compare.context}</p>
    <h1>{heading}</h1>
    <p class="lede">{m.compare.lede}</p>

    <CompareTabs client:load strings={m.islands} sides={[sideOf(a), sideOf(b)]} measured={measured !== undefined}>
      <Fragment slot="overview">
        <table class="compare" role="table">
          <caption class="visually-hidden">{heading}</caption>
          <thead role="rowgroup">
            <tr role="row">
              <th role="columnheader" scope="col"><span class="visually-hidden">{m.compare.factColumn}</span></th>
              <th role="columnheader" scope="col">
                <a href={pathFor(locale, `/tools/${a.slug}/`)}>{a.name}</a>
              </th>
              <th role="columnheader" scope="col">
                <a href={pathFor(locale, `/tools/${b.slug}/`)}>{b.name}</a>
              </th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            <CompareRow label={card.factLanguage} names={names}>
              <Fragment slot="a">
                {
                  a.repo.language ? (
                    <a href={languageHref(a.repo.language)}>{a.repo.language}</a>
                  ) : (
                    card.unknownLanguage
                  )
                }
              </Fragment>
              <Fragment slot="b">
                {
                  b.repo.language ? (
                    <a href={languageHref(b.repo.language)}>{b.repo.language}</a>
                  ) : (
                    card.unknownLanguage
                  )
                }
              </Fragment>
            </CompareRow>

            <CompareRow label={card.factLicense} names={names}>
              <Fragment slot="a">
                {a.repo.license ? <a href={licenseHref(a.repo.license)}>{a.repo.license}</a> : card.noLicense}
              </Fragment>
              <Fragment slot="b">
                {b.repo.license ? <a href={licenseHref(b.repo.license)}>{b.repo.license}</a> : card.noLicense}
              </Fragment>
            </CompareRow>

            <CompareRow label={card.factStars} names={names}>
              <Fragment slot="a"><StarCount count={a.repo.stars} /></Fragment>
              <Fragment slot="b"><StarCount count={b.repo.stars} /></Fragment>
            </CompareRow>

            <CompareRow label={card.factLatest} names={names}>
              <Fragment slot="a">
                {
                  a.release ? (
                    <>
                      <a href={a.release.url}>{a.release.tag}</a>
                      {a.release.signed && (
                        <Mark icon="signed" label={card.signed} href={pathFor(locale, "/about/#signed")} />
                      )}
                    </>
                  ) : (
                    m.tool.noRelease
                  )
                }
              </Fragment>
              <Fragment slot="b">
                {
                  b.release ? (
                    <>
                      <a href={b.release.url}>{b.release.tag}</a>
                      {b.release.signed && (
                        <Mark icon="signed" label={card.signed} href={pathFor(locale, "/about/#signed")} />
                      )}
                    </>
                  ) : (
                    m.tool.noRelease
                  )
                }
              </Fragment>
            </CompareRow>

            <CompareRow label={card.factLastPush} names={names}>
              <Fragment slot="a">{day(a.repo.pushedAt)}</Fragment>
              <Fragment slot="b">{day(b.repo.pushedAt)}</Fragment>
            </CompareRow>

            <CompareRow label={m.compare.factCadence} names={names}>
              <Fragment slot="a">{cadence(a)}</Fragment>
              <Fragment slot="b">{cadence(b)}</Fragment>
            </CompareRow>

            <CompareRow label={m.vitality.contributors} names={names}>
              <Fragment slot="a">{contributorsOf(a)}</Fragment>
              <Fragment slot="b">{contributorsOf(b)}</Fragment>
            </CompareRow>

            <CompareRow label={m.compare.factFlags} names={names}>
              <Fragment slot="a">
                {
                  flagsOf(a).length > 0
                    ? flagsOf(a).map((flag) => (
                        <a class="mark mark-warn" href={flagHref(flag)}>
                          {flagLabels[flag] ?? flag}
                        </a>
                      ))
                    : m.compare.noFlags
                }
              </Fragment>
              <Fragment slot="b">
                {
                  flagsOf(b).length > 0
                    ? flagsOf(b).map((flag) => (
                        <a class="mark mark-warn" href={flagHref(flag)}>
                          {flagLabels[flag] ?? flag}
                        </a>
                      ))
                    : m.compare.noFlags
                }
              </Fragment>
            </CompareRow>
          </tbody>
        </table>

        <section class="compare-relation">
          <p class="section-label">{m.compare.relationLabel}</p>
          <ul class="relations">
            {
              pair.edges.map((edge) => (
                <li>
                  <p class="relation-lead">
                    {format(m.compare.replacesLine, { from: nameOf(edge.from), to: nameOf(edge.to) })}{" "}
                    <a href={targetHref(edge.to)}>{targetLabel(edge.to)}</a>
                  </p>
                  <p class="relation-side">
                    <a class={`fit fit-${edge.fit}`} href={fitHref(edge.fit)}>
                      {m.islands.fit[edge.fit]}
                    </a>
                    {edge.note && <span class="relation-note">{edge.note}</span>}
                  </p>
                </li>
              ))
            }
            {
              pair.shared.map((shared) => (
                <li>
                  <p class="relation-lead">
                    {format(m.compare.sharedLine, { target: nameOf(shared.target) })}{" "}
                    <a href={targetHref(shared.target)}>{targetLabel(shared.target)}</a>
                  </p>
                  {[
                    { tool: a, relation: shared.a },
                    { tool: b, relation: shared.b },
                  ].map(({ tool, relation }) => (
                    <p class="relation-side">
                      <a class={`fit fit-${relation.fit}`} href={fitHref(relation.fit)}>
                        {m.islands.fit[relation.fit]}
                      </a>
                      <span class="relation-who">{tool.name}</span>
                      {relation.note && <span class="relation-note">{relation.note}</span>}
                    </p>
                  ))}
                </li>
              ))
            }
          </ul>
        </section>
      </Fragment>
      {
        measured && (
          <Fragment slot="performance">
            <p class="lede">{m.compare.benchmarksLede}</p>
            <ul class="benchmarks">
              {measured.data.benchmarks.map((benchmark) => (
                <li>
                  <p class="benchmark-title">{benchmark.title}</p>
                  <p class="benchmark-result">{benchmark.result}</p>
                  <p class="benchmark-meta">
                    <span>{ranBy(benchmark.ranBy, benchmark.date)}</span>
                    <a href={benchmark.url}>{m.compare.benchmarkSource}</a>
                  </p>
                </li>
              ))}
            </ul>
          </Fragment>
        )
      }
      <Fragment slot="resources">
        {
          guides.length > 0 && (
            <section class="compare-guides">
              <p class="section-label">{m.compare.guidesLabel}</p>
              <ul class="links">
                {guides.map((guide) => (
                  <li>
                    <a href={pathFor(locale, migrationPath(guide.from, guide.to))}>
                      {format(m.migrate.title, { from: nameOf(guide.from), to: nameOf(guide.to) })} →
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        <div class="compare-columns">
          {
            [a, b].map((tool) => (
              <div class="compare-column">
                <h3>{tool.name}</h3>
                <ul class="links">
                  <li>
                    <a href={pathFor(locale, `/tools/${tool.slug}/`)}>{format(m.compare.toolLink, { name: tool.name })}</a>
                  </li>
                  <li>
                    <a href={tool.repository}>{m.compare.sourceLink}</a>
                  </li>
                  {webHref(tool.repo.homepage) && (
                    <li>
                      <a href={webHref(tool.repo.homepage)}>{m.compare.homepageLink}</a>
                    </li>
                  )}
                </ul>
              </div>
            ))
          }
        </div>
      </Fragment>
    </CompareTabs>
  </div>
</Base>
