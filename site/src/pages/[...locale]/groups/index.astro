---
import type { GetStaticPaths } from "astro";

import IndexPage from "../../../components/IndexPage.astro";
import type { Locale } from "../../../i18n/index.ts";
import { format, messages, pathFor } from "../../../i18n/index.ts";
import { localePaths } from "../../../i18n/paths.ts";
import { sectionList } from "../../../lib/catalog.ts";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = messages(locale).index.groups;
const items = sectionList.map((page) => ({
  href: pathFor(locale, `/groups/${page.slug}/`),
  name: page.section.name,
  detail: page.section.description,
  count: page.tools,
}));
const count = items.length;
---

<IndexPage
  locale={locale}
  title={m.title}
  description={format(m.description, { count })}
  heading={m.heading}
  lede={format(m.lede, { count })}
  items={items}
/>
