---
import type { GetStaticPaths } from "astro";

import LinkGrid from "../../components/LinkGrid.astro";
import Search from "../../components/Search.tsx";
import Trending from "../../components/Trending.astro";
import type { Locale } from "../../i18n/index.ts";
import { format, messages, pathFor } from "../../i18n/index.ts";
import { localePaths } from "../../i18n/paths.ts";
import Base from "../../layouts/Base.astro";
import { categoryGroups, categoryName, targetItems, targets, tools } from "../../lib/catalog.ts";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = messages(locale);
const names = Object.fromEntries(targets().map((t) => [t.slug, t.name]));
const items = targetItems().map((item) => ({ ...item, href: pathFor(locale, item.href) }));
const categories = categoryGroups
  .map((group) => ({ key: group.label, name: categoryName(group.label) }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Base revealSearch title={m.home.title} description={m.home.description}>
  <section class="hero">
    <p class="eyebrow">{m.home.eyebrow}</p>
    <h1>{m.home.heading}</h1>
    <p class="lede">{format(m.home.lede, { count: tools.length })}</p>
    <div data-reveal-anchor>
      <Search
        client:load
        locale={locale}
        strings={m.islands}
        names={names}
        examples={m.home.examples}
        categories={categories}
      />
    </div>
    <noscript>
      <p class="empty">
        {m.home.noscriptBefore}<a href="#browse">{m.home.noscriptLink}</a>{m.home.noscriptAfter}
      </p>
    </noscript>
  </section>

  <Trending locale={locale} />

  <hr class="divider" />

  <section id="browse">
    <p class="section-label">{m.home.browseLabel}</p>
    <LinkGrid locale={locale} items={items} />
    <p class="links browse-more">
      <a href={pathFor(locale, "/tools/")}>{m.home.allTools}</a>
      <a href={pathFor(locale, "/categories/")}>{m.home.categories}</a>
      <a href={pathFor(locale, "/languages/")}>{m.home.languages}</a>
      <a href={pathFor(locale, "/licenses/")}>{m.home.licenses}</a>
      <a href={pathFor(locale, "/owners/")}>{m.home.owners}</a>
    </p>
  </section>

  <p class="sponsor">{m.home.sponsorNote}</p>
  <p class="links sponsor-links">
    <a href="https://opencollective.com/ferrlabs">{m.home.sponsorOpenCollective}</a>
    <a href="https://github.com/sponsors/BryanFRD">{m.home.sponsorGitHub}</a>
  </p>
</Base>
