---
import type { EnrichedTool } from "../../../../../scripts/lib/types.ts";
import type { GetStaticPaths } from "astro";

import ComparisonTable from "../../../components/ComparisonTable.astro";
import LinkGrid from "../../../components/LinkGrid.astro";
import ToolListing from "../../../components/ToolListing.astro";
import type { Locale } from "../../../i18n/index.ts";
import { format, messages, pathFor } from "../../../i18n/index.ts";
import { localePathsFor } from "../../../i18n/paths.ts";
import { categories, categoryGroups, categoryName, targetItems, targets } from "../../../lib/catalog.ts";
import { categoryDescription, categoryTitle } from "../../../lib/intent.ts";

export const getStaticPaths = (() =>
  localePathsFor(
    categoryGroups.map((group) => ({
      params: { key: group.slug },
      props: { key: group.label, tools: group.tools },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  key: string;
  tools: EnrichedTool[];
}

const { locale, key, tools } = Astro.props;
const m = messages(locale);
const name = categoryName(key);
const category = { name, description: categories[key]?.description ?? "", selfHost: categories[key]?.selfHost };
const selfHostCategories = Object.keys(categories).filter((k) => categories[k]?.selfHost === true);
const members = new Set(tools.map((tool) => tool.slug));
const replacedItems = targetItems(
  targets().filter((target) => target.alternatives.some((tool) => members.has(tool.slug))),
).map((item) => ({ ...item, href: pathFor(locale, item.href) }));
const feed = pathFor(locale, `/categories/${Astro.params.key}/feed.xml`);
---

<ToolListing
  locale={locale}
  title={categoryTitle(locale, m.category, category, tools)}
  description={categoryDescription(m.category, category, tools.length)}
  context={m.category.context}
  parent={pathFor(locale, "/categories/")}
  heading={name}
  lede={category.description}
  tools={tools}
  feeds={[{ title: format(m.changes.categoryFeedTitle, { name }), path: feed }]}
>
  <p class="feed-link"><a href={feed}>{m.changes.followCategory}</a></p>
  <section class="page-section">
    <h2>{m.category.comparison}</h2>
    <ComparisonTable locale={locale} caption={name} tools={tools} selfHostCategories={selfHostCategories} />
  </section>
  {
    replacedItems.length > 0 && (
      <section class="page-section" slot="after">
        <h2>{m.category.replaces}</h2>
        <LinkGrid locale={locale} items={replacedItems} />
      </section>
    )
  }
</ToolListing>
