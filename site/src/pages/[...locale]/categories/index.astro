---
import type { GetStaticPaths } from "astro";

import IndexPage from "../../../components/IndexPage.astro";
import type { Locale } from "../../../i18n/index.ts";
import { format, messages, pathFor } from "../../../i18n/index.ts";
import { localePaths } from "../../../i18n/paths.ts";
import { categories, categoryGroups, categoryName } from "../../../lib/catalog.ts";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = messages(locale).index.categories;
const items = categoryGroups.map((group) => ({
  href: pathFor(locale, `/categories/${group.slug}/`),
  name: categoryName(group.label),
  detail: categories[group.label]?.description,
  count: group.tools.length,
}));
const count = items.length;
---

<IndexPage
  locale={locale}
  title={m.title}
  description={format(m.description, { count })}
  heading={m.heading}
  lede={format(m.lede, { count })}
  items={items}
/>
