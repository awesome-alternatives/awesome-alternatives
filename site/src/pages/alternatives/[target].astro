---
import type { GetStaticPaths } from "astro";

import AlternativesList from "../../components/AlternativesList.tsx";
import Base from "../../layouts/Base.astro";
import { type Target, targets } from "../../lib/catalog.ts";

export const getStaticPaths = (() =>
  targets().map((target) => ({ params: { target: target.slug }, props: { target } }))) satisfies GetStaticPaths;

interface Props {
  target: Target;
}

const { target } = Astro.props;
const languages = [...new Set(target.alternatives.map((t) => t.repo.language).filter(Boolean))];
---

<Base
  title={`Alternatives to ${target.name}`}
  description={`${target.alternatives.length} alternatives to ${target.name}, in ${languages.join(", ")}. Compare fit, licence, stars and the latest signed release.`}
>
  <a class="back" href="/#browse">← back</a>
  <p class="context"><a href="/alternatives/">alternatives</a> to</p>
  <h1>
    {target.name}
    {target.listed?.repo.archived && <span class="mark mark-archived">archived</span>}
  </h1>
  {
    target.listed && (
      <p class="lede">
        {target.listed.repo.description} <a href={`/tools/${target.slug}/`}>About {target.name} →</a>
      </p>
    )
  }
  <AlternativesList client:load tools={target.alternatives} target={target.slug} />
</Base>
