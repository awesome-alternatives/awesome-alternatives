---
import { Content } from "../../../CONTRIBUTING.md";
import Base from "../layouts/Base.astro";
import { NEW_TOOL_URL, SUGGEST_TOOL_URL } from "../lib/repo.ts";
---

<Base
  title="Add a tool to awesome-alternatives"
  description="How to list a developer tool in the catalog: the YAML entry, what CI checks, how maintainers verify their tool."
>
  <section class="hero">
    <p class="eyebrow">Contribute</p>
    <h1>Add a tool</h1>
    <p class="lede">
      Every entry is a short YAML file in the repository. Write it yourself in a pull request, or describe the tool in
      an issue and a maintainer writes it for you.
    </p>
    <p class="links paths">
      <a class="repo-link" href={NEW_TOOL_URL}>Open a pull request ↗</a>
      <a href={SUGGEST_TOOL_URL}>Suggest a tool instead ↗</a>
    </p>
  </section>

  <hr class="divider" />

  <article class="prose">
    <Content />
  </article>
</Base>
