---
import type { EnrichedTool } from "../../../../scripts/lib/types.ts";
import type { GetStaticPaths } from "astro";

import ToolListing from "../../components/ToolListing.astro";
import { categories, categoryGroups, categoryName } from "../../lib/catalog.ts";

export const getStaticPaths = (() =>
  categoryGroups.map((group) => ({
    params: { key: group.slug },
    props: { key: group.label, tools: group.tools },
  }))) satisfies GetStaticPaths;

interface Props {
  key: string;
  tools: EnrichedTool[];
}

const { key, tools } = Astro.props;
const name = categoryName(key);
const description = categories[key]?.description ?? "";
---

<ToolListing
  title={`${name}: ${tools.length} open-source tools`}
  description={`${description} ${tools.length} tools compared by language, licence, stars and latest release.`}
  context="category"
  parent="/categories/"
  heading={name}
  lede={description}
  tools={tools}
/>
