---
import Search from "../components/Search.tsx";
import Base from "../layouts/Base.astro";
import { categories, targets, tools } from "../lib/catalog.ts";

const all = targets();
const names = Object.fromEntries(all.map((t) => [t.slug, t.name]));
const categoryOf = (target: (typeof all)[number]) => {
  const key = target.listed?.category ?? target.alternatives[0]?.category;
  return key ? (categories[key]?.name ?? key) : "";
};
const examples = [
  "semantic-release, but written in Rust",
  "a drop-in for webpack, faster",
  "Redis, but multithreaded",
  "changelog generator under MIT",
  "replace Terraform",
];
---

<Base
  title="awesome-alternatives: find what replaces the tool you use"
  description="Search for an alternative to a developer tool by language, licence and fit. Stars, releases and signatures come straight from GitHub."
>
  <section class="hero">
    <p class="eyebrow">Find what replaces the tool you use</p>
    <h1>Say what you use and what you need.</h1>
    <p class="lede">{tools.length} tools, release data pulled from GitHub nightly, never typed by hand</p>
    <Search client:load names={names} examples={examples} />
  </section>

  <hr class="divider" />

  <section id="browse">
    <p class="section-label">Browse by tool</p>
    <ul class="targets">
      {
        all.map((target) => (
          <li>
            <a href={`/alternatives/${target.slug}/`}>
              <span>
                <span class="target-name">
                  {target.name}
                  {target.listed?.repo.archived && <span class="mark mark-archived">archived</span>}
                </span>
                <span class="target-category">{categoryOf(target)}</span>
              </span>
              <span class="target-count">{target.alternatives.length} →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
