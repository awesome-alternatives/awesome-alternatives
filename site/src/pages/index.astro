---
import LinkGrid from "../components/LinkGrid.astro";
import Search from "../components/Search.tsx";
import Base from "../layouts/Base.astro";
import { targetItems, targets, tools } from "../lib/catalog.ts";

const names = Object.fromEntries(targets().map((t) => [t.slug, t.name]));
const examples = [
  "semantic-release, but written in Rust",
  "a drop-in for webpack, faster",
  "Redis, but multithreaded",
  "changelog generator under MIT",
  "replace Terraform",
];
---

<Base
  search={false}
  title="awesome-alternatives: find what replaces the tool you use"
  description="Search for an alternative to a developer tool by language, licence and fit. Stars, releases and signatures come straight from GitHub."
>
  <section class="hero">
    <p class="eyebrow">Find what replaces the tool you use</p>
    <h1>Say what you use and what you need.</h1>
    <p class="lede">{tools.length} tools, release data pulled from GitHub nightly, never typed by hand</p>
    <Search client:load names={names} examples={examples} />
  </section>

  <hr class="divider" />

  <section id="browse">
    <p class="section-label">Browse by tool</p>
    <LinkGrid items={targetItems()} />
    <p class="links browse-more">
      <a href="/tools/">All tools</a>
      <a href="/categories/">Categories</a>
      <a href="/languages/">Languages</a>
      <a href="/licenses/">Licences</a>
    </p>
  </section>
</Base>
