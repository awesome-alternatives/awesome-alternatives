---
import "@fontsource/courier-prime/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  search?: boolean;
}

const { title, description, search = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/og.png", Astro.site);
const REPO = "https://github.com/awesome-alternatives/awesome-alternatives";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo-512.png" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="awesome-alternatives, home">
        <span class="prompt" aria-hidden="true">&gt;</span>awesome-alternatives<span class="cursor" aria-hidden="true"></span>
      </a>
      {
        search && (
          <form class="header-search" action="/" method="get" role="search">
            <label for="header-q" class="visually-hidden">
              Search the catalog
            </label>
            <input id="header-q" name="q" type="search" maxlength="300" placeholder="Search alternatives" />
            <button type="submit" aria-label="Search">→</button>
          </form>
        )
      }
      <nav>
        <a href="/#browse">Browse</a>
        <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Add a tool</a>
        <a href={REPO}>GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Catalog <a href={`${REPO}/blob/main/LICENSE-DATA`}>CC0</a>, code <a href={`${REPO}/blob/main/LICENSE`}>MIT</a>,
        data from GitHub
      </p>
      <nav aria-label="Legal">
        <a href="/legal-notice/">Legal notice</a>
        <a href="/privacy/">Privacy</a>
        <a href={REPO}>GitHub ↗</a>
      </nav>
    </footer>
  </body>
</html>
