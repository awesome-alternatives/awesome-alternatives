---
import "@fontsource/courier-prime/latin-700.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "../styles/global.css";
import { DEFAULT_LOCALE, localeOf, LOCALES, messages, pathFor, stripLocale } from "../i18n/index.ts";
import { REPO } from "../lib/repo.ts";

interface Props {
  title: string;
  description: string;
  search?: boolean;
  revealSearch?: boolean;
  image?: SocialImage;
  noindex?: boolean;
}

interface SocialImage {
  path: string;
  alt: string;
}

const locale = localeOf(Astro.url.pathname);
const m = messages(locale);
const bare = stripLocale(Astro.url.pathname);

const DEFAULT_IMAGE: SocialImage = {
  path: "/og.png",
  alt: m.chrome.socialAlt,
};

const {
  title,
  description,
  search = true,
  revealSearch = false,
  image = DEFAULT_IMAGE,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const feed = new URL(pathFor(locale, "/feed.xml"), Astro.site);
const alternates = LOCALES.map((code) => ({
  code,
  hreflang: messages(code).locale.htmlLang,
  name: messages(code).locale.name,
  path: pathFor(code, bare),
}));
const xDefault = new URL(pathFor(DEFAULT_LOCALE, bare), Astro.site);
const link = (path: string) => pathFor(locale, path);
---

<!doctype html>
<html lang={m.locale.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex && (
        <>
          {alternates.map((alternate) => (
            <link rel="alternate" hreflang={alternate.hreflang} href={new URL(alternate.path, Astro.site)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={xDefault} />
        </>
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="awesome-alternatives" />
    <meta property="og:locale" content={m.locale.ogLocale} />
    <meta property="og:image" content={new URL(image.path, Astro.site)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={m.chrome.feedTitle} href={feed} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a class="skip-link" href="#content">{m.chrome.skipToContent}</a>
    <header class="site-header">
      <a class="brand" href={link("/")} aria-label={m.chrome.brandLabel}>
        <span class="prompt" aria-hidden="true">&gt;</span>awesome-alternatives<span class="cursor" aria-hidden="true"
        ></span>
      </a>
      {
        search && (
          <form
            class:list={["header-search", { "is-revealable": revealSearch }]}
            action={link("/")}
            method="get"
            role="search"
          >
            <label for="header-q" class="visually-hidden">
              {m.chrome.searchLabel}
            </label>
            <div
              class="search-field"
              data-suggest
              data-prefix={locale === DEFAULT_LOCALE ? "" : `/${locale}`}
              data-listbox={m.islands.search.suggestions.label}
              data-loading={m.islands.search.suggestions.loading}
              data-failed={m.islands.search.suggestions.failed}
              data-empty={m.islands.search.suggestions.empty}
              data-alternatives={m.islands.search.suggestions.alternativesTo}
            >
              <input
                id="header-q"
                name="q"
                type="search"
                maxlength="300"
                autocomplete="off"
                placeholder={m.chrome.searchPlaceholder}
              />
            </div>
            <button type="submit" aria-label={m.chrome.searchSubmit}>
              →
            </button>
          </form>
        )
      }
      <nav>
        <a href={`${link("/")}#browse`}>{m.chrome.nav.browse}</a>
        <a href={link("/about/")}>{m.chrome.nav.about}</a>
        <a href={link("/contribute/")}>{m.chrome.nav.contribute}</a>
      </nav>
      <div class="header-end">
        <div class="locales">
          <label for="locale-switch" class="visually-hidden">{m.chrome.languageLabel}</label>
          <select id="locale-switch" data-locale-switch>
            {
              alternates.map((alternate) => (
                <option value={alternate.path} lang={alternate.hreflang} selected={alternate.code === locale}>
                  {alternate.name}
                </option>
              ))
            }
          </select>
        </div>
        <noscript>
          <nav class="locales-fallback" aria-label={m.chrome.languageLabel}>
            {
              alternates.map((alternate) => (
                <a
                  href={alternate.path}
                  hreflang={alternate.hreflang}
                  lang={alternate.hreflang}
                  aria-current={alternate.code === locale ? "true" : undefined}
                >
                  {alternate.name}
                </a>
              ))
            }
          </nav>
        </noscript>
        <a class="github-link" href={REPO} aria-label={m.chrome.nav.github}>
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
          </svg>
        </a>
      </div>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        {m.chrome.footer.catalog} <a href={`${REPO}/blob/main/LICENSE-DATA`}>CC0</a>, {m.chrome.footer.code}{" "}
        <a href={`${REPO}/blob/main/LICENSE`}>MIT</a>, {m.chrome.footer.data}{" "}
        <a href={`${link("/about/")}#refresh`}>{m.chrome.footer.dataLink}</a>
      </p>
      <nav aria-label={m.chrome.footer.label}>
        <a href={link("/about/")}>{m.chrome.footer.howItWorks}</a>
        <a href={link("/feed.xml")}>{m.chrome.footer.rss}</a>
        <a href={link("/legal-notice/")}>{m.chrome.footer.legalNotice}</a>
        <a href={link("/privacy/")}>{m.chrome.footer.privacy}</a>
        <a href={REPO}>{m.chrome.footer.github}</a>
      </nav>
    </footer>
    <script>
      import { href, type SuggestIndex, suggest } from "../lib/suggest.ts";

      const anchor = document.querySelector("[data-reveal-anchor]");
      const header = document.querySelector(".site-header");
      if (header) {
        let watcher: IntersectionObserver | null = null;
        const measure = () => {
          const height = Math.round(header.getBoundingClientRect().height);
          document.documentElement.style.setProperty("--header-height", `${height}px`);
          if (!anchor) return;
          watcher?.disconnect();
          watcher = new IntersectionObserver(
            ([entry]) => {
              header.toggleAttribute("data-search-visible", !entry.isIntersecting);
            },
            { rootMargin: `-${height}px 0px 0px 0px` },
          );
          watcher.observe(anchor);
        };
        measure();
        new ResizeObserver(measure).observe(header);
      }

      for (const select of document.querySelectorAll("select[data-locale-switch]")) {
        select.addEventListener("change", () => {
          if (select instanceof HTMLSelectElement) window.location.assign(select.value);
        });
      }

      const field = document.querySelector<HTMLElement>("[data-suggest]");
      const input = field?.querySelector("input");
      if (field && input) {
        const text = field.dataset;
        const list = document.createElement("div");
        list.className = "suggestions";
        list.id = "header-suggestions";
        list.setAttribute("role", "listbox");
        list.setAttribute("aria-label", text.listbox ?? "");
        input.setAttribute("role", "combobox");
        input.setAttribute("aria-controls", list.id);
        input.setAttribute("aria-autocomplete", "list");
        input.setAttribute("aria-expanded", "false");

        let index: SuggestIndex | null = null;
        let state: "none" | "loading" | "failed" = "none";
        let rows: HTMLAnchorElement[] = [];
        let active = -1;
        let timer = 0;

        const note = (message: string) => {
          const paragraph = document.createElement("p");
          paragraph.className = "suggestion-note";
          paragraph.textContent = message;
          return paragraph;
        };

        const close = () => {
          list.remove();
          input.setAttribute("aria-expanded", "false");
          input.removeAttribute("aria-activedescendant");
          rows = [];
          active = -1;
        };

        const highlight = () => {
          rows.forEach((row, i) => {
            row.classList.toggle("is-active", i === active);
            row.setAttribute("aria-selected", String(i === active));
          });
          if (active < 0) return input.removeAttribute("aria-activedescendant");
          input.setAttribute("aria-activedescendant", rows[active].id);
          rows[active].scrollIntoView({ block: "nearest" });
        };

        const row = (name: string, detail: string, url: string, i: number) => {
          const anchorElement = document.createElement("a");
          anchorElement.className = "suggestion";
          anchorElement.id = `header-suggestion-${i}`;
          anchorElement.href = url;
          anchorElement.setAttribute("role", "option");
          anchorElement.setAttribute("aria-selected", "false");
          const label = document.createElement("span");
          label.className = "suggestion-name";
          label.textContent = name;
          const hint = document.createElement("span");
          hint.className = "suggestion-detail";
          hint.textContent = detail;
          anchorElement.append(label, hint);
          anchorElement.addEventListener("mouseenter", () => {
            active = i;
            highlight();
          });
          return anchorElement;
        };

        const render = () => {
          const query = input.value.trim();
          if (!query) return close();
          list.replaceChildren();
          rows = [];
          active = -1;
          if (state === "loading") list.append(note(text.loading ?? ""));
          else if (state === "failed") list.append(note(text.failed ?? ""));
          else if (index) {
            const items = suggest(index, query, (name) =>
              (text.alternatives ?? "{name}").replace("{name}", name),
            );
            if (items.length === 0) list.append(note(text.empty ?? ""));
            rows = items.map((item, i) =>
              row(item.name, item.detail, `${text.prefix ?? ""}${href(item)}`, i),
            );
            list.append(...rows);
          }
          field.append(list);
          input.setAttribute("aria-expanded", "true");
        };

        const load = async () => {
          state = "loading";
          render();
          try {
            const response = await fetch("/search-index.json");
            if (!response.ok) throw new Error(String(response.status));
            index = (await response.json()) as SuggestIndex;
            state = "none";
          } catch {
            state = "failed";
          }
          render();
        };

        input.addEventListener("input", () => {
          window.clearTimeout(timer);
          timer = window.setTimeout(() => {
            if (!input.value.trim()) return close();
            if (!index && state === "none") void load();
            else render();
          }, 180);
        });

        input.addEventListener("keydown", (event) => {
          if (event.key === "Escape") return close();
          if (rows.length === 0) return;
          if (event.key === "ArrowDown") {
            event.preventDefault();
            active = (active + 1) % rows.length;
            highlight();
          } else if (event.key === "ArrowUp") {
            event.preventDefault();
            active = active <= 0 ? rows.length - 1 : active - 1;
            highlight();
          } else if (event.key === "Enter" && active >= 0) {
            event.preventDefault();
            window.location.assign(rows[active].href);
          }
        });

        field.addEventListener("focusout", (event) => {
          if (!field.contains(event.relatedTarget as Node | null)) close();
        });
      }
    </script>
  </body>
</html>
